    {
      "parameters": {
        "jsCode": "const sourceText = String($json.text ?? '').replace(/\\r/g, '').trim();\n\nif (!sourceText) {\n  throw new Error('El PDF no contiene texto extraíble');\n}\n\nconst lines = sourceText.split('\\n');\nconst documentMatch = sourceText.match(/ID documental:\\s*(KB-\\d{2})\\s*\\|\\s*Versión:\\s*([^|\\n]+?)\\s*\\|\\s*Estado:\\s*([^|\\n]+)/i);\n\nif (!documentMatch) {\n  throw new Error('Cabecera documental no detectada: se esperaba ID, versión y estado');\n}\n\nconst document_id = documentMatch[1].trim().toUpperCase();\nconst version = documentMatch[2].trim();\nconst estado = documentMatch[3].trim().toUpperCase();\nconst titulo = lines.map((line) => line.trim()).find((line) => line.length > 0) ?? '';\nconst fileJson = $('Download file').item.json ?? {};\nconst nombre_archivo = String(fileJson.name ?? fileJson.originalFilename ?? '').trim();\n\nif (!titulo) {\n  throw new Error('No se ha podido obtener el título del documento');\n}\n\nif (!nombre_archivo) {\n  throw new Error('No se ha podido obtener el nombre del archivo de Drive');\n}\n\nconst headings = [];\n\nlines.forEach((line, index) => {\n  const match = line.trim().match(/^(\\d+(?:\\.\\d+)*)\\.\\s+(.+)$/);\n  if (match && match[2].trim().length > 0 && match[2].trim().length <= 100) {\n    headings.push({ index, seccion: match[1], tituloSeccion: match[2].trim() });\n  }\n});\n\nif (headings.length === 0) {\n  throw new Error(`No se han detectado secciones numeradas en ${nombre_archivo}`);\n}\n\nconst sections = headings.map((heading, idx) => {\n  const end = idx + 1 < headings.length ? headings[idx + 1].index : lines.length;\n  const sectionBody = lines.slice(heading.index, end).join('\\n').trim();\n\n  if (!sectionBody) {\n    throw new Error(`La sección ${heading.seccion} de ${nombre_archivo} está vacía`);\n  }\n\n  return {\n    json: {\n      document_id,\n      titulo,\n      version,\n      seccion: heading.seccion,\n      estado,\n      nombre_archivo,\n      text: `${document_id} | ${titulo} | Sección ${heading.seccion} | Estado: ${estado}\\n${sectionBody}`\n    }\n  };\n});\n\nreturn sections;"
      },
